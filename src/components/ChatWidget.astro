---
// ChatWidget.astro — floating AI assistant for portfolio
---

<div id="chat-widget">
	<!-- Floating tooltip (shown once after 3s) -->
	<div class="chat-tooltip" id="chatTooltip" aria-hidden="true">
		Try asking about projects, research, or experience.
	</div>

	<!-- Pill launcher: glowing circle icon + label -->
	<button class="chat-launcher" id="chatFab" aria-label="Ask Sai's AI assistant">
		<span class="launcher-orb">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path d="M12 2L13.09 8.26L19 6L14.74 10.74L21 12L14.74 13.26L19 18L13.09 15.74L12 22L10.91 15.74L5 18L9.26 13.26L3 12L9.26 10.74L5 6L10.91 8.26L12 2Z" fill="white"/>
			</svg>
		</span>
		<span class="launcher-label">Ask AI</span>
	</button>

	<!-- Chat panel -->
	<div class="chat-panel" id="chatPanel" aria-hidden="true" role="dialog" aria-label="AI assistant chat">
		<div class="chat-header">
			<div class="chat-header-info">
				<div class="chat-bot-avatar-hdr" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7H4a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7 14a1 1 0 1 0 2 0 1 1 0 0 0-2 0m8 0a1 1 0 1 0 2 0 1 1 0 0 0-2 0M4 19h16v-3H4v3z"/>
					</svg>
				</div>
				<div>
					<p class="chat-name">Sai's AI Assistant</p>
					<p class="chat-status">Ask me anything</p>
				</div>
			</div>
			<button class="chat-close-btn" id="chatClose" aria-label="Close chat">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
				</svg>
			</button>
		</div>

		<div class="chat-messages" id="chatMessages"></div>

		<div class="chat-input-area">
			<input
				type="text"
				id="chatInput"
				class="chat-input"
				placeholder="Ask about projects, skills, background..."
				autocomplete="off"
				maxlength="500"
				aria-label="Message"
			/>
			<button class="chat-send-btn" id="chatSend" aria-label="Send message">
				<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
				</svg>
			</button>
		</div>
	</div>
</div>

<style>
	#chat-widget {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 9999;
		font-family: var(--font-body);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
	}

	/* ── Tooltip ── */
	.chat-tooltip {
		background: rgba(15, 8, 30, 0.95);
		color: #ddd6fe;
		font-size: 0.72rem;
		padding: 0.45rem 0.85rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(139, 92, 246, 0.3);
		box-shadow: 0 4px 16px rgba(109, 40, 217, 0.2);
		white-space: nowrap;
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.3s ease, transform 0.3s ease;
		pointer-events: none;
	}

	.chat-tooltip.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* ── Launcher: glowing orb + label ── */
	.chat-launcher {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.42rem 1rem 0.42rem 0.42rem;
		border-radius: 9999px;
		border: 1px solid rgba(139, 92, 246, 0.35);
		background: rgba(10, 5, 25, 0.7);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		color: #e9d5ff;
		font-size: 0.82rem;
		font-weight: 600;
		font-family: var(--font-body);
		letter-spacing: 0.02em;
		box-shadow:
			0 0 20px rgba(139, 92, 246, 0.25),
			0 4px 16px rgba(0, 0, 0, 0.5);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.chat-launcher:hover {
		transform: translateY(-2px);
		box-shadow:
			0 0 30px rgba(139, 92, 246, 0.45),
			0 6px 20px rgba(0, 0, 0, 0.55);
	}

	/* Glowing circle that holds the sparkle icon */
	.launcher-orb {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		background: radial-gradient(circle at 40% 40%, #a855f7, #7c3aed);
		box-shadow:
			0 0 0 2px rgba(167, 139, 250, 0.35),
			0 0 14px rgba(167, 139, 250, 0.6),
			0 0 30px rgba(139, 92, 246, 0.3);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		animation: orb-pulse 3s ease-in-out infinite;
	}

	@keyframes orb-pulse {
		0%, 100% { box-shadow: 0 0 0 2px rgba(167,139,250,0.35), 0 0 14px rgba(167,139,250,0.6), 0 0 30px rgba(139,92,246,0.3); }
		50%       { box-shadow: 0 0 0 2px rgba(167,139,250,0.55), 0 0 22px rgba(167,139,250,0.85), 0 0 44px rgba(139,92,246,0.45); }
	}

	.launcher-label {
		line-height: 1;
		padding-right: 0.1rem;
	}

	/* ── Panel ── */
	.chat-panel {
		position: absolute;
		bottom: calc(100% + 0.75rem);
		right: 0;
		width: 340px;
		height: 490px;
		background: #0f0a1e;
		border: 1px solid rgba(139, 92, 246, 0.2);
		border-radius: 1.25rem;
		box-shadow: 0 8px 48px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(139,92,246,0.1);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transform: scale(0.92) translateY(10px);
		opacity: 0;
		pointer-events: none;
		transform-origin: bottom right;
		transition: transform 0.22s ease, opacity 0.22s ease;
	}

	.chat-panel.open {
		transform: scale(1) translateY(0);
		opacity: 1;
		pointer-events: all;
	}

	/* ── Header ── */
	.chat-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.875rem 1rem;
		background: linear-gradient(135deg, rgba(124,58,237,0.25), rgba(109,40,217,0.15));
		border-bottom: 1px solid rgba(139,92,246,0.2);
		flex-shrink: 0;
	}

	.chat-header-info {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.chat-bot-avatar-hdr {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: linear-gradient(135deg, #a855f7, #7c3aed);
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-shadow: 0 0 10px rgba(139,92,246,0.5);
	}

	.chat-name {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 600;
		color: #f3f0ff;
		line-height: 1.2;
	}

	.chat-status {
		margin: 0;
		font-size: 0.68rem;
		color: #a78bfa;
		line-height: 1.2;
	}

	.chat-close-btn {
		background: none;
		border: none;
		cursor: pointer;
		color: #7c6fa0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.3rem;
		border-radius: 0.375rem;
		transition: color 0.15s, background 0.15s;
	}

	.chat-close-btn:hover {
		color: #e0d4ff;
		background: rgba(139,92,246,0.15);
	}

	/* ── Messages area ── */
	.chat-messages {
		flex: 1;
		overflow-y: auto;
		padding: 1rem 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		scroll-behavior: smooth;
		background: #0f0a1e;
	}

	.chat-messages::-webkit-scrollbar { width: 3px; }
	.chat-messages::-webkit-scrollbar-track { background: transparent; }
	.chat-messages::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.3); border-radius: 2px; }

	/* ── Message rows — :global because these are created dynamically via JS ── */
	:global(.msg-row) {
		display: flex;
		width: 100%;
		gap: 0.5rem;
	}

	:global(.msg-row.user) {
		flex-direction: row-reverse;
		justify-content: flex-start;
	}

	:global(.msg-row.bot) {
		flex-direction: row;
		justify-content: flex-start;
		align-items: flex-end;
	}

	:global(.msg-avatar) {
		width: 1.75rem;
		height: 1.75rem;
		min-width: 1.75rem;
		border-radius: 50%;
		background: linear-gradient(135deg, #a855f7, #7c3aed);
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	:global(.msg-content) {
		display: flex;
		flex-direction: column;
		max-width: 75%;
	}

	:global(.msg-row.user .msg-content) {
		align-items: flex-end;
	}

	:global(.msg-row.bot .msg-content) {
		align-items: flex-start;
	}

	:global(.msg-bubble) {
		padding: 0.55rem 0.875rem;
		font-size: 0.84rem;
		line-height: 1.55;
		word-break: break-word;
	}

	:global(.msg-row.user .msg-bubble) {
		background: linear-gradient(135deg, #7c3aed, #6d28d9);
		color: #f5f0ff;
		border-radius: 1.1rem 1.1rem 0.2rem 1.1rem;
		box-shadow: 0 3px 14px rgba(109,40,217,0.4);
	}

	:global(.msg-row.bot .msg-bubble) {
		background: #1c1530;
		color: #ccc4e8;
		border: 1px solid rgba(139,92,246,0.15);
		border-radius: 1.1rem 1.1rem 1.1rem 0.2rem;
		box-shadow: 0 2px 8px rgba(0,0,0,0.3);
	}

	:global(.typing-bubble) {
		display: flex;
		gap: 0.3rem;
		align-items: center;
		padding: 0.65rem 0.9rem;
		background: #1c1530;
		border: 1px solid rgba(139,92,246,0.15);
		border-radius: 1.1rem 1.1rem 1.1rem 0.2rem;
	}

	:global(.typing-dot) {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #7c6fa0;
		animation: dot-bounce 1.2s infinite;
	}

	:global(.typing-dot:nth-child(2)) { animation-delay: 0.2s; }
	:global(.typing-dot:nth-child(3)) { animation-delay: 0.4s; }

	@keyframes dot-bounce {
		0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
		30%            { transform: translateY(-5px); opacity: 1; }
	}

	/* ── Input area ── */
	.chat-input-area {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 0.875rem;
		border-top: 1px solid rgba(139,92,246,0.15);
		flex-shrink: 0;
		background: #0f0a1e;
	}

	.chat-input {
		flex: 1;
		background: #1c1530;
		border: 1px solid rgba(139,92,246,0.25);
		border-radius: 1.5rem;
		padding: 0.5rem 0.9rem;
		color: #e0d4ff;
		font-size: 0.84rem;
		outline: none;
		transition: border-color 0.15s;
		font-family: var(--font-body);
	}

	.chat-input::placeholder { color: #5a5170; }
	.chat-input:focus { border-color: rgba(139,92,246,0.6); }

	.chat-send-btn {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		background: linear-gradient(135deg, #a855f7, #7c3aed);
		color: white;
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: opacity 0.15s, transform 0.15s;
		box-shadow: 0 2px 10px rgba(139,92,246,0.4);
	}

	.chat-send-btn:hover:not(:disabled) { transform: scale(1.1); }
	.chat-send-btn:disabled { opacity: 0.4; cursor: not-allowed; }

	@media (max-width: 400px) {
		.chat-panel { width: calc(100vw - 3rem); }
	}
</style>

<script>
	const fab      = document.getElementById('chatFab')!;
	const panel    = document.getElementById('chatPanel')!;
	const closeBtn = document.getElementById('chatClose')!;
	const msgsEl   = document.getElementById('chatMessages')!;
	const input    = document.getElementById('chatInput') as HTMLInputElement;
	const sendBtn  = document.getElementById('chatSend') as HTMLButtonElement;
	const tooltip  = document.getElementById('chatTooltip')!;

	let isOpen    = false;
	let isLoading = false;
	const history: { role: string; content: string }[] = [];

	// Show tooltip once after 3s, dismiss after 5s
	if (!sessionStorage.getItem('chatTooltipShown')) {
		setTimeout(() => {
			if (!isOpen) {
				tooltip.classList.add('visible');
				setTimeout(() => {
					tooltip.classList.remove('visible');
					sessionStorage.setItem('chatTooltipShown', '1');
				}, 5000);
			}
		}, 3000);
	}

	function togglePanel() {
		isOpen = !isOpen;
		panel.classList.toggle('open', isOpen);
		panel.setAttribute('aria-hidden', String(!isOpen));
		tooltip.classList.remove('visible');
		sessionStorage.setItem('chatTooltipShown', '1');
		if (isOpen && history.length === 0) {
			addBotMessage("Hi! I'm Sai's AI assistant. Ask me anything about her background, projects, research, or how to get in touch.");
		}
		if (isOpen) setTimeout(() => input.focus(), 200);
	}

	function escapeHtml(s: string) {
		return s
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/\n/g, '<br>');
	}

	function addMessage(role: 'user' | 'bot', text: string) {
		const row = document.createElement('div');
		row.className = `msg-row ${role}`;

		if (role === 'bot') {
			row.innerHTML = `
				<div class="msg-avatar">AI</div>
				<div class="msg-content">
					<div class="msg-bubble">${escapeHtml(text)}</div>
				</div>`;
		} else {
			row.innerHTML = `
				<div class="msg-content">
					<div class="msg-bubble">${escapeHtml(text)}</div>
				</div>`;
		}

		msgsEl.appendChild(row);
		msgsEl.scrollTop = msgsEl.scrollHeight;
	}

	function addBotMessage(text: string) { addMessage('bot', text); }
	function addUserMessage(text: string) { addMessage('user', text); }

	function showTyping() {
		const row = document.createElement('div');
		row.className = 'msg-row bot';
		row.id = 'typing-indicator';
		row.innerHTML = `
			<div class="msg-avatar">AI</div>
			<div class="msg-content">
				<div class="typing-bubble">
					<span class="typing-dot"></span>
					<span class="typing-dot"></span>
					<span class="typing-dot"></span>
				</div>
			</div>`;
		msgsEl.appendChild(row);
		msgsEl.scrollTop = msgsEl.scrollHeight;
	}

	function hideTyping() {
		document.getElementById('typing-indicator')?.remove();
	}

	async function sendMessage() {
		const text = input.value.trim();
		if (!text || isLoading) return;

		input.value = '';
		isLoading = true;
		sendBtn.disabled = true;

		addUserMessage(text);
		history.push({ role: 'user', content: text });
		showTyping();

		try {
			const res  = await fetch('/api/chat', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ messages: history }),
			});
			const data = await res.json();
			const reply = data.reply || "Sorry, I couldn't respond. Please try again.";
			history.push({ role: 'assistant', content: reply });
			hideTyping();
			addBotMessage(reply);
		} catch {
			hideTyping();
			addBotMessage("Something went wrong. You can reach Sai directly at saideepa0501@gmail.com.");
		}

		isLoading = false;
		sendBtn.disabled = false;
		input.focus();
	}

	fab.addEventListener('click', togglePanel);
	closeBtn.addEventListener('click', togglePanel);
	sendBtn.addEventListener('click', sendMessage);
	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
	});
</script>
