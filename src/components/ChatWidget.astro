---
// ChatWidget.astro — floating AI assistant for portfolio
---

<div id="chat-widget">
	<!-- Floating tooltip (shown once after 3s) -->
	<div class="chat-tooltip" id="chatTooltip" aria-hidden="true">
		Try asking about projects, research, or experience.
	</div>

	<!-- Sleek pill launcher -->
	<button class="chat-launcher" id="chatFab" aria-label="Ask Sai's AI assistant">
		<span class="launcher-icon">✨</span>
		<span class="launcher-label">Ask AI</span>
	</button>

	<!-- Chat panel -->
	<div class="chat-panel" id="chatPanel" aria-hidden="true" role="dialog" aria-label="AI assistant chat">
		<div class="chat-header">
			<div class="chat-header-info">
				<div class="chat-bot-avatar" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7H4a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7 14a1 1 0 1 0 2 0 1 1 0 0 0-2 0m8 0a1 1 0 1 0 2 0 1 1 0 0 0-2 0M4 19h16v-3H4v3z"/>
					</svg>
				</div>
				<div>
					<p class="chat-name">Sai's AI Assistant</p>
					<p class="chat-status">Ask me anything</p>
				</div>
			</div>
			<button class="chat-close-btn" id="chatClose" aria-label="Close chat">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
				</svg>
			</button>
		</div>

		<div class="chat-messages" id="chatMessages"></div>

		<div class="chat-input-area">
			<input
				type="text"
				id="chatInput"
				class="chat-input"
				placeholder="Ask about projects, skills, background..."
				autocomplete="off"
				maxlength="500"
				aria-label="Message"
			/>
			<button class="chat-send-btn" id="chatSend" aria-label="Send message">
				<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
				</svg>
			</button>
		</div>
	</div>
</div>

<style>
	#chat-widget {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 9999;
		font-family: var(--font-body);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
	}

	/* ── Tooltip ── */
	.chat-tooltip {
		background: rgba(20, 10, 35, 0.92);
		color: #e0d4ff;
		font-size: 0.72rem;
		padding: 0.45rem 0.8rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(160, 80, 220, 0.3);
		box-shadow: 0 4px 16px rgba(120, 40, 200, 0.25);
		white-space: nowrap;
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.3s ease, transform 0.3s ease;
		pointer-events: none;
		max-width: 240px;
		text-align: right;
	}

	.chat-tooltip.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* ── Pill launcher ── */
	.chat-launcher {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 1.1rem;
		border-radius: 9999px;
		border: 1px solid rgba(160, 80, 220, 0.45);
		background: rgba(255, 255, 255, 0.04);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		color: #e0d4ff;
		font-size: 0.82rem;
		font-weight: 600;
		font-family: var(--font-body);
		letter-spacing: 0.01em;
		box-shadow:
			0 0 0 1px rgba(160, 80, 220, 0.2),
			0 0 18px rgba(160, 60, 220, 0.3),
			0 4px 20px rgba(0, 0, 0, 0.4);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.chat-launcher:hover {
		transform: translateY(-2px);
		background: rgba(255, 255, 255, 0.07);
		box-shadow:
			0 0 0 1px rgba(160, 80, 220, 0.4),
			0 0 28px rgba(160, 60, 220, 0.5),
			0 6px 24px rgba(0, 0, 0, 0.5);
	}

	.launcher-icon {
		font-size: 1rem;
		line-height: 1;
	}

	.launcher-label {
		line-height: 1;
	}

	/* ── Panel ── */
	.chat-panel {
		position: absolute;
		bottom: calc(100% + 0.75rem);
		right: 0;
		width: 340px;
		height: 480px;
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transform: scale(0.92) translateY(8px);
		opacity: 0;
		pointer-events: none;
		transform-origin: bottom right;
		transition: transform 0.22s ease, opacity 0.22s ease;
	}

	.chat-panel.open {
		transform: scale(1) translateY(0);
		opacity: 1;
		pointer-events: all;
	}

	/* ── Header ── */
	.chat-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.875rem 1.125rem;
		background: var(--gradient-subtle);
		border-bottom: 1px solid var(--gray-800);
		flex-shrink: 0;
	}

	.chat-header-info {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.chat-bot-avatar {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.chat-name {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.2;
	}

	.chat-status {
		margin: 0;
		font-size: 0.7rem;
		color: var(--gray-400);
		line-height: 1.2;
	}

	.chat-close-btn {
		background: none;
		border: none;
		cursor: pointer;
		color: var(--gray-400);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.3rem;
		border-radius: 0.375rem;
		transition: color 0.15s, background-color 0.15s;
	}

	.chat-close-btn:hover {
		color: var(--gray-200);
		background-color: var(--gray-800);
	}

	/* ── Messages (iMessage style) ── */
	.chat-messages {
		flex: 1;
		overflow-y: auto;
		padding: 1rem 0.875rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		scroll-behavior: smooth;
	}

	.chat-messages::-webkit-scrollbar { width: 3px; }
	.chat-messages::-webkit-scrollbar-track { background: transparent; }
	.chat-messages::-webkit-scrollbar-thumb { background: var(--gray-700); border-radius: 2px; }

	/* Message row */
	.msg {
		display: flex;
		flex-direction: column;
		max-width: 80%;
		width: fit-content;
		gap: 0.2rem;
	}

	.msg.user {
		align-self: flex-end;
		align-items: flex-end;
		margin-left: auto;
	}

	.msg.bot {
		align-self: flex-start;
		align-items: flex-start;
		margin-right: auto;
	}

	/* Sender label */
	.msg-sender {
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0 0.3rem;
	}

	.msg.user .msg-sender {
		color: #a78bfa;
	}

	.msg.bot .msg-sender {
		color: #94a3b8;
	}

	/* Bubble */
	.msg-bubble {
		padding: 0.55rem 0.875rem;
		font-size: 0.85rem;
		line-height: 1.55;
		word-break: break-word;
	}

	/* User bubble — purple, right tail */
	.msg.user .msg-bubble {
		background: linear-gradient(135deg, #7c3aed, #6d28d9);
		color: #f3f0ff;
		border-radius: 1.1rem 1.1rem 0.25rem 1.1rem;
		box-shadow: 0 2px 12px rgba(109, 40, 217, 0.35);
	}

	/* Bot bubble — dark slate, left tail */
	.msg.bot .msg-bubble {
		background: #1e1e2e;
		color: #cbd5e1;
		border: 1px solid rgba(148, 163, 184, 0.1);
		border-radius: 1.1rem 1.1rem 1.1rem 0.25rem;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
	}

	/* ── Typing indicator ── */
	.typing-bubble {
		display: flex;
		gap: 0.28rem;
		align-items: center;
		padding: 0.65rem 0.875rem;
		background: #1e1e2e;
		border: 1px solid rgba(148, 163, 184, 0.1);
		border-radius: 1.1rem 1.1rem 1.1rem 0.25rem;
	}

	.typing-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #64748b;
		animation: dot-bounce 1.2s infinite;
	}

	.typing-dot:nth-child(2) { animation-delay: 0.2s; }
	.typing-dot:nth-child(3) { animation-delay: 0.4s; }

	@keyframes dot-bounce {
		0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
		30%            { transform: translateY(-5px); opacity: 1; }
	}

	/* ── Input area ── */
	.chat-input-area {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 0.875rem;
		border-top: 1px solid var(--gray-800);
		flex-shrink: 0;
		background: var(--gray-999);
	}

	.chat-input {
		flex: 1;
		background: var(--gray-800);
		border: 1px solid var(--gray-700);
		border-radius: 1.5rem;
		padding: 0.5rem 0.9rem;
		color: var(--gray-200);
		font-size: 0.85rem;
		outline: none;
		transition: border-color 0.15s;
		font-family: var(--font-body);
	}

	.chat-input::placeholder { color: var(--gray-500); }
	.chat-input:focus { border-color: var(--accent-regular); }

	.chat-send-btn {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: opacity 0.15s, transform 0.15s;
	}

	.chat-send-btn:hover:not(:disabled) { transform: scale(1.08); }
	.chat-send-btn:disabled { opacity: 0.45; cursor: not-allowed; }

	@media (max-width: 400px) {
		.chat-panel {
			width: calc(100vw - 3rem);
		}
	}
</style>

<script>
	const fab      = document.getElementById('chatFab')!;
	const panel    = document.getElementById('chatPanel')!;
	const closeBtn = document.getElementById('chatClose')!;
	const msgsEl   = document.getElementById('chatMessages')!;
	const input    = document.getElementById('chatInput') as HTMLInputElement;
	const sendBtn  = document.getElementById('chatSend') as HTMLButtonElement;
	const tooltip  = document.getElementById('chatTooltip')!;

	let isOpen    = false;
	let isLoading = false;
	const history: { role: string; content: string }[] = [];

	// Show tooltip once after 3s, hide after 5s
	if (!sessionStorage.getItem('chatTooltipShown')) {
		setTimeout(() => {
			if (!isOpen) {
				tooltip.classList.add('visible');
				setTimeout(() => {
					tooltip.classList.remove('visible');
					sessionStorage.setItem('chatTooltipShown', '1');
				}, 5000);
			}
		}, 3000);
	}

	function togglePanel() {
		isOpen = !isOpen;
		panel.classList.toggle('open', isOpen);
		panel.setAttribute('aria-hidden', String(!isOpen));
		// Hide tooltip when user opens chat
		tooltip.classList.remove('visible');
		sessionStorage.setItem('chatTooltipShown', '1');
		if (isOpen && history.length === 0) {
			addBotMessage("Hi! I'm Sai's AI assistant. Ask me anything about her background, projects, research, or how to get in touch.");
		}
		if (isOpen) setTimeout(() => input.focus(), 200);
	}

	function escapeHtml(text: string) {
		return text
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/\n/g, '<br>');
	}

	function addMessage(role: 'user' | 'bot', text: string) {
		const div = document.createElement('div');
		div.className = `msg ${role}`;
		const senderLabel = role === 'user' ? 'You' : 'Sai\'s AI';
		div.innerHTML = `
			<span class="msg-sender">${senderLabel}</span>
			<div class="msg-bubble">${escapeHtml(text)}</div>
		`;
		msgsEl.appendChild(div);
		msgsEl.scrollTop = msgsEl.scrollHeight;
	}

	function addBotMessage(text: string) { addMessage('bot', text); }
	function addUserMessage(text: string) { addMessage('user', text); }

	function showTyping() {
		const div = document.createElement('div');
		div.className = 'msg bot';
		div.id = 'typing-indicator';
		div.innerHTML = `
			<span class="msg-sender">Sai's AI</span>
			<div class="typing-bubble">
				<span class="typing-dot"></span>
				<span class="typing-dot"></span>
				<span class="typing-dot"></span>
			</div>
		`;
		msgsEl.appendChild(div);
		msgsEl.scrollTop = msgsEl.scrollHeight;
	}

	function hideTyping() {
		document.getElementById('typing-indicator')?.remove();
	}

	async function sendMessage() {
		const text = input.value.trim();
		if (!text || isLoading) return;

		input.value = '';
		isLoading = true;
		sendBtn.disabled = true;

		addUserMessage(text);
		history.push({ role: 'user', content: text });
		showTyping();

		try {
			const res  = await fetch('/api/chat', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ messages: history }),
			});
			const data = await res.json();
			const reply = data.reply || "Sorry, I couldn't respond. Please try again.";
			history.push({ role: 'assistant', content: reply });
			hideTyping();
			addBotMessage(reply);
		} catch {
			hideTyping();
			addBotMessage("Something went wrong. You can reach Sai directly at saideepa0501@gmail.com.");
		}

		isLoading = false;
		sendBtn.disabled = false;
		input.focus();
	}

	fab.addEventListener('click', togglePanel);
	closeBtn.addEventListener('click', togglePanel);
	sendBtn.addEventListener('click', sendMessage);
	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			sendMessage();
		}
	});
</script>
