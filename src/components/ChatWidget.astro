---
// ChatWidget.astro — floating AI assistant for portfolio
---

<div id="chat-widget">
	<!-- Floating robot launcher card -->
	<div class="chat-launcher" id="chatFab" role="button" tabindex="0" aria-label="Chat with Sai's AI assistant">
		<div class="robot-body">
			<svg viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="robot-svg" aria-hidden="true">
				<!-- antenna -->
				<line x1="40" y1="18" x2="40" y2="6" stroke="#e0e8ff" stroke-width="3" stroke-linecap="round"/>
				<circle cx="40" cy="4" r="4" fill="#7eb8ff"/>
				<!-- head -->
				<rect x="14" y="18" width="52" height="36" rx="10" fill="#dce9ff"/>
				<!-- eye sockets -->
				<rect x="20" y="28" width="16" height="16" rx="5" fill="#2255cc"/>
				<rect x="44" y="28" width="16" height="16" rx="5" fill="#2255cc"/>
				<!-- eye shine -->
				<circle cx="26" cy="33" r="4" fill="#7eb8ff"/>
				<circle cx="50" cy="33" r="4" fill="#7eb8ff"/>
				<circle cx="28" cy="31" r="1.5" fill="white"/>
				<circle cx="52" cy="31" r="1.5" fill="white"/>
				<!-- mouth -->
				<rect x="28" y="47" width="24" height="4" rx="2" fill="#aac4ff"/>
				<!-- neck -->
				<rect x="34" y="54" width="12" height="6" rx="2" fill="#c5d8ff"/>
				<!-- body -->
				<rect x="10" y="60" width="60" height="34" rx="10" fill="#dce9ff"/>
				<!-- chest panel -->
				<rect x="24" y="68" width="32" height="18" rx="5" fill="#aac4ff" opacity="0.6"/>
				<circle cx="35" cy="77" r="3" fill="#2255cc"/>
				<circle cx="45" cy="77" r="3" fill="#7eb8ff"/>
				<!-- left arm (waving) -->
				<path d="M10 66 Q0 60 2 50" stroke="#dce9ff" stroke-width="8" stroke-linecap="round" fill="none"/>
				<circle cx="2" cy="48" r="5" fill="#c5d8ff"/>
				<!-- right arm -->
				<path d="M70 66 Q80 72 78 80" stroke="#dce9ff" stroke-width="8" stroke-linecap="round" fill="none"/>
				<circle cx="78" cy="82" r="5" fill="#c5d8ff"/>
			</svg>
		</div>
		<button class="start-chat-btn">Start chat</button>
	</div>

	<!-- Chat panel -->
	<div class="chat-panel" id="chatPanel" aria-hidden="true" role="dialog" aria-label="AI assistant chat">
		<div class="chat-header">
			<div class="chat-header-info">
				<div class="chat-bot-avatar" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7H4a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7 14a1 1 0 1 0 2 0 1 1 0 0 0-2 0m8 0a1 1 0 1 0 2 0 1 1 0 0 0-2 0M4 19h16v-3H4v3z"/>
					</svg>
				</div>
				<div>
					<p class="chat-name">Sai's AI Assistant</p>
					<p class="chat-status">Ask me anything</p>
				</div>
			</div>
			<button class="chat-close-btn" id="chatClose" aria-label="Close chat">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
				</svg>
			</button>
		</div>

		<div class="chat-messages" id="chatMessages"></div>

		<div class="chat-input-area">
			<input
				type="text"
				id="chatInput"
				class="chat-input"
				placeholder="Ask about projects, skills, background..."
				autocomplete="off"
				maxlength="500"
				aria-label="Message"
			/>
			<button class="chat-send-btn" id="chatSend" aria-label="Send message">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
				</svg>
			</button>
		</div>
	</div>
</div>

<style>
	#chat-widget {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 9999;
		font-family: var(--font-body);
	}

	/* ── Robot launcher card ── */
	.chat-launcher {
		cursor: pointer;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
		width: 105px;
		background: #0d0d1f;
		border-radius: 1.1rem;
		padding: 0.9rem 0.6rem 0.75rem;
		position: relative;
		transition: transform 0.2s ease;
		/* gradient border via box-shadow */
		box-shadow:
			0 0 0 2px transparent,
			0 0 0 2.5px rgba(160, 80, 220, 0.8),
			0 0 16px rgba(200, 80, 180, 0.4),
			0 4px 24px rgba(0, 0, 0, 0.5);
		background-clip: padding-box;
	}

	.chat-launcher::before {
		content: '';
		position: absolute;
		inset: -2px;
		border-radius: 1.35rem;
		background: linear-gradient(135deg, #c850c0, #7c3aed, #4f8ef7);
		z-index: -1;
	}

	.chat-launcher:hover {
		transform: translateY(-3px);
	}

	.robot-body {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 64px;
	}

	.robot-svg {
		width: 56px;
		height: 64px;
		filter: drop-shadow(0 2px 8px rgba(126, 184, 255, 0.35));
	}

	.start-chat-btn {
		margin-top: 0.4rem;
		background: white;
		color: #1a1a2e;
		border: none;
		border-radius: 2rem;
		padding: 0.3rem 0.75rem;
		font-size: 0.72rem;
		font-weight: 600;
		cursor: pointer;
		width: 100%;
		transition: background 0.15s;
		font-family: var(--font-body);
	}

	.start-chat-btn:hover {
		background: #eef2ff;
	}

	/* ── Panel ── */
	.chat-panel {
		position: absolute;
		bottom: calc(100% + 0.75rem);
		right: 0;
		width: 340px;
		height: 480px;
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transform: scale(0.92) translateY(8px);
		opacity: 0;
		pointer-events: none;
		transform-origin: bottom right;
		transition: transform 0.22s ease, opacity 0.22s ease;
	}

	.chat-panel.open {
		transform: scale(1) translateY(0);
		opacity: 1;
		pointer-events: all;
	}

	/* ── Header ── */
	.chat-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.875rem 1.125rem;
		background: var(--gradient-subtle);
		border-bottom: 1px solid var(--gray-800);
		flex-shrink: 0;
	}

	.chat-header-info {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.chat-bot-avatar {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.chat-name {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.2;
	}

	.chat-status {
		margin: 0;
		font-size: 0.7rem;
		color: var(--gray-400);
		line-height: 1.2;
	}

	.chat-close-btn {
		background: none;
		border: none;
		cursor: pointer;
		color: var(--gray-400);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.3rem;
		border-radius: 0.375rem;
		transition: color 0.15s, background-color 0.15s;
	}

	.chat-close-btn:hover {
		color: var(--gray-200);
		background-color: var(--gray-800);
	}

	/* ── Messages ── */
	.chat-messages {
		flex: 1;
		overflow-y: auto;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		scroll-behavior: smooth;
	}

	.chat-messages::-webkit-scrollbar { width: 3px; }
	.chat-messages::-webkit-scrollbar-track { background: transparent; }
	.chat-messages::-webkit-scrollbar-thumb { background: var(--gray-700); border-radius: 2px; }

	.msg {
		display: flex;
		flex-direction: column;
		max-width: 84%;
	}

	.msg.user { align-self: flex-end; }
	.msg.bot  { align-self: flex-start; }

	.msg-bubble {
		padding: 0.55rem 0.875rem;
		border-radius: 1rem;
		font-size: 0.85rem;
		line-height: 1.55;
		word-break: break-word;
	}

	.msg.user .msg-bubble {
		background: var(--accent-regular);
		color: var(--accent-text-over);
		border-bottom-right-radius: 0.2rem;
	}

	.msg.bot .msg-bubble {
		background: var(--gray-800);
		color: var(--gray-200);
		border-bottom-left-radius: 0.2rem;
	}

	/* ── Typing indicator ── */
	.typing-bubble {
		display: flex;
		gap: 0.28rem;
		align-items: center;
		padding: 0.65rem 0.875rem;
		background: var(--gray-800);
		border-radius: 1rem;
		border-bottom-left-radius: 0.2rem;
	}

	.typing-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--gray-400);
		animation: dot-bounce 1.2s infinite;
	}

	.typing-dot:nth-child(2) { animation-delay: 0.2s; }
	.typing-dot:nth-child(3) { animation-delay: 0.4s; }

	@keyframes dot-bounce {
		0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
		30%            { transform: translateY(-5px); opacity: 1; }
	}

	/* ── Input area ── */
	.chat-input-area {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 0.875rem;
		border-top: 1px solid var(--gray-800);
		flex-shrink: 0;
		background: var(--gray-999);
	}

	.chat-input {
		flex: 1;
		background: var(--gray-800);
		border: 1px solid var(--gray-700);
		border-radius: 1.5rem;
		padding: 0.5rem 0.9rem;
		color: var(--gray-200);
		font-size: 0.85rem;
		outline: none;
		transition: border-color 0.15s;
		font-family: var(--font-body);
	}

	.chat-input::placeholder { color: var(--gray-500); }
	.chat-input:focus { border-color: var(--accent-regular); }

	.chat-send-btn {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: opacity 0.15s, transform 0.15s;
	}

	.chat-send-btn:hover:not(:disabled) { transform: scale(1.08); }
	.chat-send-btn:disabled { opacity: 0.45; cursor: not-allowed; }

	@media (max-width: 400px) {
		.chat-panel {
			width: calc(100vw - 3rem);
		}
	}
</style>

<script>
	const fab      = document.getElementById('chatFab')!;
	const panel    = document.getElementById('chatPanel')!;
	const closeBtn = document.getElementById('chatClose')!;
	const msgsEl   = document.getElementById('chatMessages')!;
	const input    = document.getElementById('chatInput') as HTMLInputElement;
	const sendBtn  = document.getElementById('chatSend') as HTMLButtonElement;

	let isOpen    = false;
	let isLoading = false;
	const history: { role: string; content: string }[] = [];

	function togglePanel() {
		isOpen = !isOpen;
		panel.classList.toggle('open', isOpen);
		panel.setAttribute('aria-hidden', String(!isOpen));
		if (isOpen && history.length === 0) {
			addBotMessage("Hi! I'm Sai's AI assistant. Ask me anything about her background, projects, research, or how to get in touch.");
		}
		if (isOpen) setTimeout(() => input.focus(), 200);
	}

	function escapeHtml(text: string) {
		return text
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/\n/g, '<br>');
	}

	function addMessage(role: 'user' | 'bot', text: string) {
		const div = document.createElement('div');
		div.className = `msg ${role}`;
		div.innerHTML = `<div class="msg-bubble">${escapeHtml(text)}</div>`;
		msgsEl.appendChild(div);
		msgsEl.scrollTop = msgsEl.scrollHeight;
	}

	function addBotMessage(text: string) { addMessage('bot', text); }
	function addUserMessage(text: string) { addMessage('user', text); }

	function showTyping() {
		const div = document.createElement('div');
		div.className = 'msg bot';
		div.id = 'typing-indicator';
		div.innerHTML = `<div class="typing-bubble">
			<span class="typing-dot"></span>
			<span class="typing-dot"></span>
			<span class="typing-dot"></span>
		</div>`;
		msgsEl.appendChild(div);
		msgsEl.scrollTop = msgsEl.scrollHeight;
	}

	function hideTyping() {
		document.getElementById('typing-indicator')?.remove();
	}

	async function sendMessage() {
		const text = input.value.trim();
		if (!text || isLoading) return;

		input.value = '';
		isLoading = true;
		sendBtn.disabled = true;

		addUserMessage(text);
		history.push({ role: 'user', content: text });
		showTyping();

		try {
			const res  = await fetch('/api/chat', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ messages: history }),
			});
			const data = await res.json();
			const reply = data.reply || "Sorry, I couldn't respond. Please try again.";
			history.push({ role: 'assistant', content: reply });
			hideTyping();
			addBotMessage(reply);
		} catch {
			hideTyping();
			addBotMessage("Something went wrong. You can reach Sai directly at saideepa0501@gmail.com.");
		}

		isLoading = false;
		sendBtn.disabled = false;
		input.focus();
	}

	fab.addEventListener('click', togglePanel);
	fab.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); togglePanel(); } });
	closeBtn.addEventListener('click', togglePanel);
	sendBtn.addEventListener('click', sendMessage);
	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			sendMessage();
		}
	});
</script>
