---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data } = Astro.props.project;
---

<details class="card">
	<summary class="card-summary">
		{data.tags?.[0] && <p class="card-tag">{data.tags[0]}</p>}
		<p class="card-title">{data.title}</p>
		<span class="card-chevron" aria-hidden="true">›</span>
	</summary>
	<div class="card-body">
		{data.description && <p class="card-desc">{data.description}</p>}
		{data.tags && data.tags.length > 1 && (
			<div class="card-tags">
				{data.tags.map((tag: string) => (
					<span class="card-pill">{tag}</span>
				))}
			</div>
		)}
	</div>
</details>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		font-family: var(--font-brand);
		transition: box-shadow var(--theme-transition), background-color var(--theme-transition);
	}

	.card[open] {
		box-shadow: var(--shadow-md);
		background-color: var(--accent-subtle-overlay);
	}

	.card-summary {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.25rem 1.5rem;
		cursor: pointer;
		list-style: none;
		position: relative;
	}

	.card-summary::-webkit-details-marker {
		display: none;
	}

	.card-summary:hover {
		background-color: var(--accent-subtle-overlay);
	}

	.card-chevron {
		position: absolute;
		top: 1.1rem;
		right: 1.25rem;
		font-size: 1.2rem;
		color: var(--gray-400);
		transition: transform 0.2s ease;
		line-height: 1;
	}

	.card[open] .card-chevron {
		transform: rotate(90deg);
	}

	.card-tag {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent-regular);
		margin: 0;
	}

	.card-title {
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--gray-200);
		line-height: 1.5;
		margin: 0;
		padding-right: 1.5rem;
	}

	.card-body {
		padding: 0 1.5rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.card-desc {
		font-size: var(--text-sm);
		color: var(--gray-300);
		line-height: 1.6;
		margin: 0;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.card-pill {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.2rem 0.6rem;
		border-radius: 999rem;
		background-color: var(--accent-regular);
		color: var(--accent-text-over);
	}

	@media (min-width: 50em) {
		.card {
			border-radius: 1.5rem;
			min-height: 7rem;
		}
	}
</style>
