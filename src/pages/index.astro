---
import { getCollection } from 'astro:content';
import BlogPreview from '../components/BlogPreview.astro';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 3);

const skills = [
	{
		group: 'AI Systems & Frameworks',
		color: '#7c3aed',
		items: [
			'LLMs, RAG Pipelines, Agentic AI',
			'Multi-Agent Systems',
			'LangChain, LlamaIndex, Hugging Face',
			'Vector Databases (FAISS, Pinecone)',
			'OpenAI API, Embedding Models',
			'Prompt Engineering',
		],
	},
	{
		group: 'Neuromorphic & RL Research',
		color: '#2563eb',
		items: [
			'Reinforcement Learning',
			'Spiking Neural Networks (snnTorch, PyTorch)',
			'Deep Reinforcement Learning',
			'Surrogate Gradient Learning',
			'Transformers, CNNs, RNNs, LSTMs',
			'Spike Encodings & Energy Trade-offs',
		],
	},
	{
		group: 'Engineering & Deployment',
		color: '#0d9488',
		items: [
			'Python, Java, SQL, C++',
			'FastAPI, REST APIs, Spring Boot',
			'Docker, CI/CD, GitHub Actions',
			'AWS',
			'ETL Pipelines',
		],
	},
];

const publications = [
	{
		venue: 'IEEE Access · 2026',
		title: 'Exploring Neuromorphic Computing for Reinforcement Learning: A Survey and Review',
		href: 'https://ieeexplore.ieee.org/abstract/document/11353437',
	},
	{
		venue: 'IOP Neuromorphic Computing & Engineering · Under Review',
		title: 'Deep Spiking Q-Networks for Turn-Based Game Environments: Encoding Choices and Energy Trade-offs',
		href: null,
	},
	{
		venue: 'IEEE Conference on Games (CoG) · 2025',
		title: 'RL- and LLM-Based AI Solvers for Wordle and Fibble',
		href: 'https://ieeexplore.ieee.org/abstract/document/11114257',
	},
];
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hi, I'm Sai Deepa Kadaru"
					tagline="AI/ML Engineer with strong expertise in building intelligent systems using machine learning, deep learning, and reinforcement learning techniques."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> AI/ML Engineer</Pill>
						<Pill><Icon icon="pencil-line" size="1.33em" /> Researcher</Pill>
						<Pill><Icon icon="trophy" size="1.33em" /> Published Author</Pill>
					</div>
				</Hero>

				<img
					alt="Sai Deepa Kadaru profile photo"
					width="480"
					height="620"
					src="/assets/portrait.jpg"
				/>
			</header>
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">

			<div class="about-wrapper">
				<section class="about-section">
					<h2 class="about-section-title">Background</h2>
					<div class="about-content">
						<p>
							I recently completed my MS in Computer Science at Ohio University, where my thesis focuses
							on neuromorphic computing and spiking neural networks with the intersection of reinforcement
							learning, where I explore energy-efficient alternatives to traditional deep RL using
							biologically inspired hardware.
						</p>
						<p>
							On the engineering side, I build production-grade AI systems: RAG pipelines,
							multi-agent orchestrators, LLM monitoring stacks, and backend APIs that actually ship.
							I care deeply about reliability, clarity, and systems that non-technical collaborators
							can operate without hand-holding.
						</p>
					</div>
				</section>

				<section class="about-section">
					<h2 class="about-section-title">Education</h2>
					<div class="about-content">
						<div class="edu-entry">
							<div class="edu-header">
								<strong>Ohio University</strong>&nbsp;· Athens, OH
								<span class="edu-dates">Aug 2023 – Dec 2026</span>
							</div>
							<p class="edu-degree">Master of Science, Computer Science &nbsp;·&nbsp; GPA: 3.7 / 4.0</p>
						</div>
						<div class="edu-entry">
							<div class="edu-header">
								<strong>Osmania University</strong>&nbsp;· Hyderabad, India
								<span class="edu-dates">Aug 2019 – Jul 2023</span>
							</div>
							<p class="edu-degree">Bachelor of Engineering, Computer Science</p>
						</div>
					</div>
				</section>

				<section class="about-section">
					<h2 class="about-section-title">Experience</h2>
					<div class="about-content">
						<div class="edu-entry">
							<div class="edu-header">
								<strong>Graduate Research Assistant</strong>&nbsp;· Ohio University
								<span class="edu-dates">Aug 2023 – Aug 2026</span>
							</div>
							<ul>
								<li>Designed &amp; deployed end-to-end AI systems using LLMs, RAG pipelines, and agent frameworks on AWS, translating high-level research designs into working production components.</li>
								<li>Built and integrated AI systems with existing data infrastructure via REST APIs and microservices, navigating real-world auth flows and distributed environments.</li>
								<li>Debugged and optimized production AI pipelines, identifying failure modes and tuning retrieval and inference components for reliability under real operating conditions.</li>
								<li>Wrote modular, reusable Python code across LLM integration, vector search, and agent orchestration layers with clear documentation.</li>
							</ul>
						</div>
						<div class="edu-entry">
							<div class="edu-header">
								<strong>Programmer Analyst Intern</strong>&nbsp;· Cognizant
								<span class="edu-dates">Feb 2023 – Jul 2023</span>
							</div>
							<ul>
								<li>Automated backend QA workflows using Selenium and Java for enterprise clients, delivering production-ready automation that reduced manual testing effort measurably.</li>
								<li>Documented testing methodologies, failure patterns, and resolution strategies for both client and internal teams.</li>
							</ul>
						</div>
					</div>
				</section>

				<section class="about-section">
					<h2 class="about-section-title">Skills</h2>
					<div class="about-content">
						<div class="skills-grid">
							{skills.map((group) => (
								<div class="skill-group">
									<h3 class="skill-group-title">{group.group}</h3>
									<div class="skill-pills">
										{group.items.map((item) => (
											<span class="skill-pill" style={{ backgroundColor: group.color }}>{item}</span>
										))}
									</div>
								</div>
							))}
						</div>
					</div>
				</section>
			</div>

			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>My Projects</h3>
					<p>Production AI systems, research projects, and published work — each built to solve a real problem.</p>
				</header>

				<div class="cta">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Publications</h3>
					<p>
						Peer-reviewed research in neuromorphic computing, reinforcement learning, and LLM-based game solvers.
					</p>
				</header>

				<div class="gallery">
					<Grid variant="small">
						{
							publications.map((pub) => (
								<li class="mention-card">
									{pub.href ? (
										<a href={pub.href} target="_blank" rel="noopener noreferrer" class="pub-link">
											<p class="pub-venue">{pub.venue}</p>
											<p class="pub-title">{pub.title}</p>
										</a>
									) : (
										<div class="pub-link">
											<p class="pub-venue">{pub.venue}</p>
											<p class="pub-title">{pub.title}</p>
										</div>
									)}
								</li>
							))
						}
					</Grid>
				</div>
			</section>

			<section class="section with-background blog-section with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>From the Blog</h3>
					<p>Thoughts on AI engineering, neuromorphic computing, and building things that work in production.</p>
				</header>

				<div class="gallery blog-gallery">
					{recentPosts.map((post) => <BlogPreview post={post} />)}
				</div>

				<div class="cta">
					<CallToAction href="/blog/">
						All Posts
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<div class="about-wrapper">
				<section class="about-section">
					<h2 class="about-section-title">Contact</h2>
					<div class="about-content">
						<div class="contact-links">
							<a href="https://github.com/saideepa05" target="_blank" rel="noopener noreferrer">GitHub</a>
							<a href="https://www.linkedin.com/in/sai-deepa/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
							<a href="mailto:saideepa0501@gmail.com">saideepa0501@gmail.com</a>
						</div>
					</div>
				</section>
			</div>

		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	/* ====================================================== */
	/* Hero */

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */
	/* About-style two-column sections */

	.about-wrapper {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		color: var(--gray-200);
	}

	.about-section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.about-section-title {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.about-content p {
		margin: 0 0 1rem;
	}

	.about-content a {
		color: var(--accent-regular);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.about-content a:hover {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about-section {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
			align-items: start;
			font-size: var(--text-lg);
		}

		.about-section-title {
			grid-column: 1;
			padding-top: 0.2rem;
		}

		.about-content {
			grid-column: 2 / 4;
		}
	}

	/* Education & Experience */
	.edu-entry {
		margin-bottom: 1.75rem;
	}

	.edu-entry:last-child {
		margin-bottom: 0;
	}

	.edu-header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		align-items: baseline;
		color: var(--gray-0);
		margin-bottom: 0.25rem;
	}

	.edu-dates {
		margin-left: auto;
		color: var(--gray-400);
		white-space: nowrap;
	}

	.edu-degree {
		margin: 0 0 0.4rem;
		color: var(--gray-300);
	}

	.edu-detail {
		margin: 0 0 0.3rem;
		color: var(--gray-300);
		line-height: 1.6;
	}

	.edu-entry ul {
		margin: 0.25rem 0 0 1.1rem;
		padding: 0;
		color: var(--gray-300);
		line-height: 1.7;
	}

	/* Skills */
	.skills-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.skill-group {
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		padding: 1.5rem 1.75rem;
	}

	.skill-group-title {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-regular);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 0.9rem;
	}

	.skill-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.skill-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 1.4rem;
		border-radius: 999rem;
		color: #fff;
		font-size: var(--text-md);
		font-weight: 500;
		line-height: 1.2;
	}

	/* Contact */
	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		align-items: center;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	@media (max-width: 49.9em) {
		.skills-grid {
			grid-template-columns: 1fr;
		}

		.edu-dates {
			margin-left: 0;
			width: 100%;
		}
	}

	/* ====================================================== */
	/* Styled sections (Projects, Publications, Blog) */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */
	/* Publications cards */

	.mention-card {
		display: flex;
		min-height: 7rem;
		justify-content: center;
		align-items: stretch;
		text-align: left;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
	}

	.pub-link {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.25rem 1.5rem;
		text-decoration: none;
		color: inherit;
		width: 100%;
		transition: background-color var(--theme-transition);
	}

	a.pub-link:hover {
		background-color: var(--accent-subtle-overlay);
	}

	.pub-venue {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent-regular);
		margin: 0;
	}

	.pub-title {
		font-size: var(--text-sm);
		line-height: 1.4;
		margin: 0;
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			min-height: 9.5rem;
		}
	}

	/* ====================================================== */
	/* Blog section */

	.blog-gallery {
		display: grid;
		gap: 1rem;
		grid-column: 1 / -1;
	}

	@media (min-width: 50em) {
		.blog-gallery {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}

		.blog-section {
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
		}

		.blog-section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}
	}
</style>
