---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Projects | Sai Deepa Kadaru"
	description="Production AI systems, research projects, and published work by Sai Deepa Kadaru."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Work"
				tagline="Production AI systems, research projects, and published work. Each project was built to solve a real problem — not just to exist."
				align="start"
			/>
			<div class="projects-grid">
				{
					projects.map((project) => (
						<PortfolioPreview project={project} />
					))
				}
			</div>
		</main>
		<ContactCTA />
	</div>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	@media (min-width: 50em) {
		.projects-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}
</style>
</BaseLayout>
